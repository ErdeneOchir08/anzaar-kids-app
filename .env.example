# ANZAAR Application Environment Variables

# QPay 3.0 API Configuration
QPAY_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=your_qpay_username_here
QPAY_PASSWORD=your_qpay_password_here
QPAY_INVOICE_CODE=your_invoice_code_here

# App URL (Update in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis Permanent Cloud Database
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
